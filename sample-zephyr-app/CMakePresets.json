{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceParentDir}/build/${presetName}"
    },
    {
      "name": "nucleo_g474re",
      "displayName": "STM32 Nucleo G474RE (Debug)",
      "description": "ST Nucleo G474RE; -Og and thread awareness from debug.conf; west flash through OpenOCD",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "nucleo_g474re",
        "EXTRA_CONF_FILE": "debug.conf",
        "BOARD_FLASH_RUNNER": "openocd"
      }
    },
    {
      "name": "nucleo_g474re-release",
      "displayName": "STM32 Nucleo G474RE (Release)",
      "description": "ST Nucleo G474RE; Zephyr defaults (-Os); west flash through OpenOCD",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "nucleo_g474re",
        "BOARD_FLASH_RUNNER": "openocd"
      }
    },
    {
      "name": "native_sim",
      "displayName": "Native Sim (Debug)",
      "description": "Native simulator; -Og and thread awareness from debug.conf",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "native_sim",
        "EXTRA_CONF_FILE": "debug.conf"
      }
    },
    {
      "name": "native_sim-release",
      "displayName": "Native Sim (Release)",
      "description": "Native simulator; Zephyr defaults (-Os)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "native_sim"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "nucleo_g474re",
      "displayName": "Build Nucleo G474RE (Debug)",
      "configurePreset": "nucleo_g474re"
    },
    {
      "name": "nucleo_g474re-release",
      "displayName": "Build Nucleo G474RE (Release)",
      "configurePreset": "nucleo_g474re-release"
    },
    {
      "name": "native_sim",
      "displayName": "Build Native Sim (Debug)",
      "configurePreset": "native_sim"
    },
    {
      "name": "native_sim-release",
      "displayName": "Build Native Sim (Release)",
      "configurePreset": "native_sim-release"
    }
  ]
}
