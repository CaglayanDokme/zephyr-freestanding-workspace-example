{
    "name": "Zephyr RTOS Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "remoteUser": "user",
    "runArgs": [
        "--privileged",
        "-v",
        "/dev:/dev"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.gemini,target=/home/user/.gemini,type=bind",
        "source=claude-code-config,target=/home/user/.claude,type=volume",
        "source=zephyrproject-rtos,target=/opt/zephyrproject-rtos,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/user/.claude"
    },
    "postCreateCommand": "bash .devcontainer/setup-zephyr.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twister-zephyr.zephyr-workbench",
                "marus25.cortex-debug",
                "eamodio.gitlens",
                "twxs.cmake",
                "plorefice.devicetree"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            }
        }
    }
}