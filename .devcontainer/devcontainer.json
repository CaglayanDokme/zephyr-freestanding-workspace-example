{
    "name": "Zephyr RTOS Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "user",
    "runArgs": [
        "--privileged",
        "-v",
        "/dev:/dev",
        // Share the host's network namespace. Debugging a board plugged into another machine runs
        // OpenOCD next to the board and reaches it through an SSH reverse forward, which sshd binds
        // on this host's loopback interface; a container on the default bridge network cannot
        // connect to that, one on the host network simply uses localhost:3333. The container is
        // already privileged with the host's /dev, so no isolation is given up that it still had.
        // Existing containers need a rebuild to pick this up. See docs/remote-debugging.md.
        "--network=host"
    ],
    "mounts": [
        // Claude Code sign-in, settings and session history: one Docker volume per host user,
        // shared by every dev container of that user on this machine (the PetaLinux ones mount
        // the same volume), so you sign in once per machine. CLAUDE_CONFIG_DIR below moves
        // ~/.claude.json (the OAuth session) into it. Anything running in the container can
        // read these credentials. The CLI itself is installed in the image (Dockerfile).
        "source=claude-code-config-${localEnv:USER},target=/home/user/.claude,type=volume",
        "source=zephyrproject-rtos,target=/opt/zephyrproject-rtos,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/user/.claude"
    },
    // Declared for hosts that enforce it (GitHub Codespaces). The local Dev Containers
    // extension does NOT check these, so the same figures are documented in README.md
    // where a developer will actually read them.
    //
    // storage: measured - 32.2 GB image + ~2.7 GB per Zephyr version in the shared
    //          volume, leaving headroom for builds and a second version.
    // memory:  a floor, not a measurement. This app's build peaks around 2.6 GB
    //          including the VS Code server; 8 GB leaves room for -j on many cores
    //          and for applications larger than this sample.
    // cpus:    a floor. Builds scale with cores; nothing here requires 4.
    "hostRequirements": {
        "storage": "40gb",
        "memory": "8gb",
        "cpus": 4
    },
    "postCreateCommand": "bash .devcontainer/setup-zephyr.sh",
    // Without this, "waitFor" defaults to "updateContentCommand" and VS Code attaches
    // while setup-zephyr.sh is still running west init/update: the first terminal looks
    // ready but every west command fails. Waiting blocks the window during the first
    // clone, which is the intended trade.
    "waitFor": "postCreateCommand",
    // Every start, not just creation. The shared Zephyr volume is read-write and shared
    // with every other dev container on this host, so it can be changed between sessions
    // by another project. Runs after postCreateCommand on first creation, and again on
    // each subsequent start. A failure notifies without blocking the container.
    "postStartCommand": "bash .devcontainer/verify-zephyr.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "marus25.cortex-debug",
                "eamodio.gitlens",
                "twxs.cmake",
                "plorefice.devicetree"
            ]
            // No terminal profile is set here on purpose. Which shell a developer uses is a
            // personal choice, so it belongs in their own VS Code user settings alongside
            // "dotfiles.repository", not in a definition every teammate inherits. With nothing
            // set, VS Code falls back to the account's login shell, which the Dockerfile leaves
            // as bash.
        }
    }
}