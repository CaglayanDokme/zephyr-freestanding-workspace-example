{
    "version": "2.0.0",
    "tasks": [
        {
            // Board on the machine that runs this container: the README's west command. west rebuilds
            // the active preset itself. env.sh gives it ZEPHYR_BASE, without which west cannot find
            // its workspace. The nucleo presets set BOARD_FLASH_RUNNER=openocd, so no --runner.
            "label": "Flash (Nucleo G474RE, probe on the container host)",
            "type": "process",
            "command": "bash",
            "args": ["-c", "source env.sh && west flash --build-dir ${command:cmake.buildDirectory}"],
            "problemMatcher": []
        },
        {
            // Board on your local machine: programs the flash through the OpenOCD reached over the SSH
            // forward on localhost:3333 (docs/remote-debugging.md), then lets the firmware run.
            "label": "Flash (Nucleo G474RE, probe on your local machine via SSH)",
            "type": "process",
            "dependsOn": "CMake: build",
            "command": "${config:cortex-debug.armToolchainPath}/arm-zephyr-eabi-gdb",
            "args": [
                "-batch",
                "-ex", "target extended-remote localhost:3333",
                "-ex", "load",
                "-ex", "monitor reset run",
                "${command:cmake.buildDirectory}/zephyr/zephyr.elf"
            ],
            "problemMatcher": []
        }
    ]
}
