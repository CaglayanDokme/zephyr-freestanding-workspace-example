{
    "version": "0.2.0",
    // Every configuration builds and debugs the active CMake preset; pick it in the CMake panel first.
    "configurations": [
        {
            // Board plugged into the machine that runs this container; cortex-debug starts OpenOCD
            // here. Needs the host udev rules: README, "Probe Access". "rtos": "auto" lets OpenOCD
            // pick up the thread list a Debug preset exports (debug.conf); a Release ELF just has none.
            "name": "Debug (Nucleo G474RE, probe on the container host)",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "CMake: build",
            "executable": "${command:cmake.buildDirectory}/zephyr/zephyr.elf",
            "servertype": "openocd",
            "configFiles": ["board/st_nucleo_g4.cfg"],
            "rtos": "auto",
            "runToEntryPoint": "main"
        },
        {
            // Board plugged into the machine in front of you while the container runs elsewhere:
            // OpenOCD runs next to the board and an SSH forward brings its GDB port to
            // localhost:3333. Setup: docs/remote-debugging.md.
            "name": "Debug (Nucleo G474RE, probe on your local machine via SSH)",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "CMake: build",
            "executable": "${command:cmake.buildDirectory}/zephyr/zephyr.elf",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "runToEntryPoint": "main"
        },
        {
            // Host build under the host GDB, not the SDK's. Needs a native_sim preset active.
            "name": "Debug (native_sim)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "CMake: build",
            "program": "${command:cmake.buildDirectory}/zephyr/zephyr.exe",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
        }
    ]
}
