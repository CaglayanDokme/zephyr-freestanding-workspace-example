{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with OpenOCD (Nucleo G474RE)",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.buildDirectory}/zephyr/zephyr.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "/opt/toolchains/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "configFiles": [
                "board/st_nucleo_g4.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach to OpenOCD Server",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.buildDirectory}/zephyr/zephyr.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbPath": "/opt/toolchains/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "gdbTarget": "localhost:3333"
        },
        {
            "name": "Debug Native Sim (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/zephyr/zephyr.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}